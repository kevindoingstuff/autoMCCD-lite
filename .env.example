# Copy to .env and fill in. Never commit .env.
# `automccd-lite serve` creates this file from the example when it is missing.

# LLM: one OpenAI-compatible endpoint. The model name lives in
# config/default.yaml -> draft.model; LLM_MODEL overrides it when set.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# LLM_MODEL=

# WHO ICD-API container. `automccd-lite serve` starts it on ICD_PORT (default
# 8082) as a named container and leaves it running; ICD_API_URL is where the
# api, the eval and the notebooks reach it.
ICD_API_URL=http://localhost:8082
# ICD_PORT=8082

# Where the api listens (loopback) and where it keeps what it stores: the
# SQLite file store/certificates.sqlite and the JSON files under
# store/certificates/. STORE_DIR defaults to <repo>/store.
API_PORT=8000
# STORE_DIR=
