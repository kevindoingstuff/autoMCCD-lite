# Copy to .env and fill in. Never commit .env.

# LLM: one OpenAI-compatible endpoint. The model name lives in
# config/default.yaml -> draft.model; LLM_MODEL overrides it when set.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# LLM_MODEL=

# WHO ICD-API container as seen from the HOST (the eval and the notebooks).
# compose publishes it on ICD_PORT (default 8082); inside the containers the
# api reaches it at http://icd-api:80.
ICD_API_URL=http://localhost:8082
# ICD_PORT=8082

# Host port the api is published on, loopback only.
API_PORT=8000

# Postgres (libpq names). compose publishes it on PGPORT (default 5433) and
# pins PGHOST=postgres, PGPORT=5432 inside the containers. Not a secret.
PGHOST=localhost
PGPORT=5433
PGDATABASE=automccd
PGUSER=automccd
PGPASSWORD=automccd

# Blob: the Azurite emulator's published development account, not a secret.
# Keep the quotes: the value contains ';'.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
AZURE_STORAGE_CONTAINER=certificates
